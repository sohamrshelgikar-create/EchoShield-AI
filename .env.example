# EchoShield AI configuration. Copy to .env (git-ignored). Contains NO secrets.
# AWS credentials are NOT stored here: Bedrock uses your AWS CLI profile below.

# Safe default: local rule-based analysis only, no AWS calls at all.
# Set to true only after your AWS account is verified and Bedrock access works.
USE_BEDROCK=false

AWS_PROFILE=echoshield
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Optional tuning (defaults shown)
# BEDROCK_MAX_TOKENS=512
# BEDROCK_TIMEOUT_SECONDS=10
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# APP_ENV=development
